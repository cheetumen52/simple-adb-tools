{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple ADB tools",
  "version": "1.2.1",
  "identifier": "cz.hejzlar-development.simple-adb-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple ADB tools",
        "width": 1040,
        "height": 920,
        "minWidth": 860,
        "minHeight": 760,
        "center": true,
        "backgroundColor": "#0a0d12",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Install APKs and handle everyday adb work",
    "longDescription": "Simple ADB tools by Hejzlar Development: APK installs, logcat, screen mirroring, Wi‑Fi debugging and more adb tools without a terminal.",
    "copyright": "© 2026 Hejzlar Development",
    "publisher": "Hejzlar Development",
    "homepage": "https://hejzlar-development.cz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "apk"
        ],
        "name": "Android Package",
        "description": "Android aplikace",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.android.package-archive"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Resources/cs.lproj/InfoPlist.strings": "locales/cs.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Czech",
          "English"
        ],
        "customLanguageFiles": {
          "Czech": "nsis/Czech.nsh"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCOENCNkQ2MzE5NDJCNTIKUldSU0s1UXgxcmFNVzlLa2RmMzZKOUJSaHpkK3JBaUlhb0oxWU1jN1c4RDN6U1pXb2o3VUY1Vk0K",
      "endpoints": [
        "https://github.com/cheetumen52/simple-adb-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
