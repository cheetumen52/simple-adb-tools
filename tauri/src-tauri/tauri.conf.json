{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple ADB tools",
  "version": "1.1.0",
  "identifier": "cz.hejzlar-development.simple-adb-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple ADB tools",
        "width": 1040,
        "height": 920,
        "minWidth": 860,
        "minHeight": 760,
        "center": true,
        "backgroundColor": "#0a0d12",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Instalace APK a každodenní práce s adb",
    "longDescription": "Simple ADB tools od Hejzlar Development: instalace APK, logcat, zrcadlení obrazovky, Wi‑Fi ladění a další adb nástroje bez terminálu.",
    "copyright": "© 2026 Hejzlar Development",
    "publisher": "Hejzlar Development",
    "homepage": "https://hejzlar-development.cz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["apk"],
        "name": "Android Package",
        "description": "Android aplikace",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.android.package-archive"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Czech", "English"]
      }
    }
  }
}
